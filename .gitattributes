# Normalize line endings in the repo to LF, regardless of platform.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never touch.
*.png   binary
*.jpg   binary
*.tga   binary
*.exr   binary
*.dds   binary
*.tif   binary
*.tiff  binary
*.ico   binary
