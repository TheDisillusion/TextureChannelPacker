{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "texture-channel-packer",
  "version-string": "0.0.0",
  "description": "Native desktop tool for packing R/G/B/A channels of texture maps.",
  "license": "MIT",
  "supports": "windows & !uwp & !static",
  "builtin-baseline": "d015e31e90838a4c9dfa3eed45979bc70d9357fc",
  "dependencies": [
    {
      "name": "catch2",
      "version>=": "3.5.0"
    }
  ],
  "features": {
    "imaging": {
      "description": "Pulls in OpenImageIO for the core image pipeline. Enabled from Phase 1 onward.",
      "dependencies": [
        {
          "name": "openimageio",
          "default-features": false,
          "features": ["openexr", "tools"],
          "version>=": "2.5.0"
        }
      ]
    },
    "gui": {
      "description": "Pulls in Qt 6 for the desktop app. Enabled from Phase 2 onward.",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["gui", "widgets", "opengl", "opengl-widgets"]
        },
        {
          "name": "qtimageformats"
        }
      ]
    }
  }
}
